# Dockerfile for Mattermost with OpenID Connect (Keycloak) support
#
# Builds from the build context, i.e. this working tree — including uncommitted
# changes. The build context must be the repository root; see .dockerignore for
# what is left out of it.

# =============================================================================
# Stage 1: Build server
# =============================================================================
FROM golang:1.26-trixie AS go-builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

WORKDIR /src/server

# .git is excluded from the build context, so the commit the Makefile would
# otherwise read from it has to be passed in.
ARG BUILD_HASH=unknown

# Build only for the architecture of the image being produced; plain `build-linux`
# builds amd64 and arm64 both and throws one of them away. TARGETARCH is supplied
# by BuildKit; without it, fall back to the toolchain's own GOARCH.
# setup-go-work (a prerequisite of build-linux-*) generates go.work itself.
#
# bin/ exists in git only through the .gitignore file inside it, which .dockerignore
# drops along with the rest of the directory — recreate it, because `go build -o bin
# ./...` fails if bin is not already a directory.
ARG TARGETARCH
RUN mkdir -p bin && make build-linux-${TARGETARCH:-$(go env GOARCH)} \
    BUILD_NUMBER=docker \
    BUILD_ENTERPRISE=false \
    BUILD_HASH=${BUILD_HASH} \
    MMCTL_GIT_COMMIT=${BUILD_HASH}

# =============================================================================
# Stage 2: Build webapp
# =============================================================================
FROM node:24-trixie AS webapp-builder

WORKDIR /src
COPY . .

WORKDIR /src/webapp

# Install dependencies and build webapp
RUN npm ci && npm run build

# =============================================================================
# Stage 3: Final runtime image
# =============================================================================
FROM debian:trixie-slim AS runtime

# Build Arguments
ARG PUID=2000
ARG PGID=2000

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    media-types \
    mailcap \
    unrtf \
    wv \
    poppler-utils \
    tidy \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Create mattermost user and directories
RUN mkdir -p /mattermost/data /mattermost/plugins /mattermost/client/plugins \
    /mattermost/logs /mattermost/config /mattermost/bin \
    && groupadd --gid ${PGID} mattermost \
    && useradd --uid ${PUID} --gid ${PGID} --comment "" --home-dir /mattermost mattermost

# Copy server binary
COPY --from=go-builder --chown=mattermost:mattermost \
    /src/server/bin/mattermost /mattermost/bin/mattermost
COPY --from=go-builder --chown=mattermost:mattermost \
    /src/server/bin/mmctl /mattermost/bin/mmctl

# Copy webapp
COPY --from=webapp-builder --chown=mattermost:mattermost \
    /src/webapp/channels/dist /mattermost/client


# Copy i18n files
COPY --from=go-builder --chown=mattermost:mattermost \
    /src/server/i18n /mattermost/i18n

# Copy templates
COPY --from=go-builder --chown=mattermost:mattermost \
    /src/server/templates /mattermost/templates

# Copy fonts
COPY --from=go-builder --chown=mattermost:mattermost \
    /src/server/fonts /mattermost/fonts

# Create PostgreSQL client SSL directory
RUN mkdir -p /mattermost/.postgresql \
    && chmod 700 /mattermost/.postgresql \
    && chown -R mattermost:mattermost /mattermost

# Environment
ENV PATH="/mattermost/bin:${PATH}"
ENV MM_SERVICESETTINGS_ENABLELOCALMODE="true"
ENV MM_INSTALL_TYPE="docker"

USER mattermost
WORKDIR /mattermost

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s \
    CMD ["/mattermost/bin/mmctl", "system", "status", "--local"]

EXPOSE 8065 8067 8074 8075

VOLUME ["/mattermost/data", "/mattermost/logs", "/mattermost/config", "/mattermost/plugins", "/mattermost/client/plugins"]

CMD ["/mattermost/bin/mattermost"]
