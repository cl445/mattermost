# Settings for docker-compose.openid.yml — copy to .env and fill in.
#
#   cp .env.openid.example .env
#
# .env holds secrets and is ignored by git; never commit the filled-in copy.

# --- Mattermost -------------------------------------------------------------

# Public URL of this Mattermost instance.
MM_SITE_URL=http://localhost:8065

# Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=

# --- OpenID Connect / Keycloak ----------------------------------------------

# Client ID of the Mattermost client in your Keycloak realm.
MM_OPENID_CLIENT_ID=mattermost

# Client secret from the client's "Credentials" tab in the Keycloak admin console.
MM_OPENID_CLIENT_SECRET=

# Discovery document of the realm. Mattermost resolves the authorization, token
# and userinfo endpoints from it, so those need no separate configuration.
# Format: https://<keycloak-host>/realms/<realm>/.well-known/openid-configuration
MM_OPENID_DISCOVERY_ENDPOINT=

# Login button appearance (optional).
MM_OPENID_BUTTON_TEXT=Login mit Keycloak
MM_OPENID_BUTTON_COLOR=#0052CC

# --- Optional local Keycloak ------------------------------------------------
# Only used with `docker compose -f docker-compose.openid.yml --profile keycloak up`.

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Build ------------------------------------------------------------------

# Commit stamped into the binary; .git is not part of the build context.
# Set it with: BUILD_HASH=$(git rev-parse HEAD)
BUILD_HASH=unknown
